{
  "name": "crypto-bot",
  "version": "0.1.0",
  "description": "Automated Solana memecoin trading bot with paper and live execution.",
  "type": "module",
  "bin": {
    "solana-trade-engine": "./dist/src/cli/index.js"
  },
  "scripts": {
    "bot": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "crypto",
    "paper-trading",
    "solana",
    "jupiter"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "better-sqlite3": "^12.10.0",
    "commander": "^15.0.0",
    "pino": "^10.3.1",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
